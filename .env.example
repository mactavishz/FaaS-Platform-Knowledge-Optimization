# tinyFaaS/faasd Local Development Configuration
# Copy this file to .env and customize as needed
# .env is git-ignored and won't be committed

# Enable or disable autoscaler (true/false or 1/0)
AUTOSCALER_ENABLED=true

# Enable or disable callgraph tracking and prewarming (true/false or 1/0)
# When enabled, the callgraph module tracks function call relationships and execution times, and can prewarm functions based on this data.
CALLGRAPH_ENABLED=true

# Enable or disable callgraph prewarming (true/false or 1/0)
# When enabled, the callgraph module will prewarm functions based on the tracked call relationships and execution times.
# This can help reduce cold start latency for frequently called functions.
CALLGRAPH_PREWARM_ENABLED=true

# Averaging method for callgraph execution-time statistics (SMA or EMA, case-insensitive)
# Falls back to SMA when unset or invalid.
CALLGRAPH_METHOD=SMA

# SMA window size used when CALLGRAPH_METHOD resolves to SMA
# Must be a positive integer. Invalid values fall back to 10.
CALLGRAPH_SMA_WINDOW_SIZE=10

# EMA alpha used when CALLGRAPH_METHOD resolves to EMA
# Must be > 0 and <= 1. Invalid values fall back to 0.3.
CALLGRAPH_EMA_ALPHA=0.3

# How long functions stay idle before scaling to zero
# Examples: 30s, 2m, 5m, 15m, 1h
DEFAULT_SCALE_TO_ZERO_IDLE_DURATION=5m

# How often the autoscaler scans for idle functions to scale to zero.
# This bounds scale-down detection latency: an idle function is scaled down at
# the first scan tick after it crosses DEFAULT_SCALE_TO_ZERO_IDLE_DURATION, so
# keep this well below the idle duration. Must be a positive duration.
# Falls back to 5s when unset or invalid. Examples: 2s, 5s, 10s
AUTOSCALER_CHECK_INTERVAL=5s

# Development or production environment (development/production)
ENV=development

# IP address for the Gateway to listen on (default: 0.0.0.0)
GATEWAY_IP=0.0.0.0

# Port for the Gateway
GATEWAY_PORT=8080

# Port for the merged tinyFaaS internal server, only tinyFaaS-relevant
TINYFAAS_PORT=8000
