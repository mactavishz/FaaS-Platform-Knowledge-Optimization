# tinyFaaS Local Development Configuration
# Copy this file to .tinyfaas.env and customize as needed
# .tinyfaas.env is git-ignored and won't be committed

# Enable or disable autoscaler (true/false or 1/0)
TF_AUTOSCALER_ENABLED=true

# How long functions stay idle before scaling to zero
# Examples: 30s, 2m, 5m, 15m, 1h
TF_DEFAULT_SCALE_TO_ZERO_IDLE_DURATION=5m

TF_ENV=development