# tinyFaaS Local Development Configuration
# Copy this file to .tinyfaas.env and customize as needed
# .tinyfaas.env is git-ignored and won't be committed

# Enable or disable autoscaler (true/false or 1/0)
TF_AUTOSCALER_ENABLED=true

# Enable or disable callgraph tracking and prewarming (true/false or 1/0)
# When enabled, the callgraph module tracks function call relationships
# and uses this data to predict which functions will be called next,
# proactively warming their containers before they are needed.
# Prewarming requires TF_AUTOSCALER_ENABLED=true to work.
TF_CALLGRAPH_ENABLED=true

# How long functions stay idle before scaling to zero
# Examples: 30s, 2m, 5m, 15m, 1h
TF_DEFAULT_SCALE_TO_ZERO_IDLE_DURATION=5m

# Development or production environment (development/production)
TF_ENV=development

# IP address for the Gateway to listen on (default: 0.0.0.0)
TF_GATEWAY_IP=0.0.0.0

# Port for the Gateway
TF_GATEWAY_PORT=80

# Port for the RProxy
TF_RPROXY_PORT=8000

# Port for the Manager
TF_MANAGER_PORT=8080
